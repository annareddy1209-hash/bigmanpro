
import pandas as pd


REQUIRED_COLUMNS = [
    "open",
    "high",
    "low",
    "close",
]


def validate_data(data):
    if not isinstance(data, pd.DataFrame):
        raise TypeError("Data must be a pandas DataFrame.")

    missing = [
        column for column in REQUIRED_COLUMNS
        if column not in data.columns
    ]

    if missing:
        raise ValueError(
            f"Missing columns: {', '.join(missing)}"
        )

    if data.empty:
        raise ValueError("Candle data is empty.")

    candles = data.copy()

    for column in REQUIRED_COLUMNS:
        candles[column] = pd.to_numeric(
            candles[column],
            errors="coerce",
        )

    if candles[REQUIRED_COLUMNS].isna().any().any():
        raise ValueError("Invalid OHLC values.")

    invalid = (
        (candles["high"] < candles["low"])
        | (candles["high"] < candles["open"])
        | (candles["high"] < candles["close"])
        | (candles["low"] > candles["open"])
        | (candles["low"] > candles["close"])
    )

    if invalid.any():
        raise ValueError("Invalid candle structure.")

    return candles.reset_index(drop=True)


def detect_inducement(
    data,
    bos_index,
    inducement_level,
    direction,
):
    """
    Detect the first qualifying IDM break after a confirmed BOS.

    direction:
        BULLISH: price breaks below the pullback level.
        BEARISH: price breaks above the pullback level.

    A wick or body crossing qualifies.
    A candle-body close beyond the level is not required.

    BOS confirmation and selection of the correct IDM level
    must be performed by the structure-analysis layer.
    """

    candles = validate_data(data)

    try:
        bos_index = int(bos_index)
        level = float(inducement_level)
    except (TypeError, ValueError, OverflowError):
        raise ValueError(
            "BOS index and inducement level must be numeric."
        )

    if isinstance(bos_index, bool):
        raise ValueError("Invalid BOS index.")

    if not pd.notna(level):
        raise ValueError("Invalid inducement level.")

    if bos_index < 0 or bos_index >= len(candles):
        raise ValueError("BOS index is outside candle data.")

    side = str(direction).strip().upper()

    if side not in ("BULLISH", "BEARISH"):
        raise ValueError(
            "Direction must be BULLISH or BEARISH."
        )

    # Search only candles occurring after the BOS candle.
    for index in range(bos_index + 1, len(candles)):

        candle = candles.iloc[index]

        if side == "BULLISH":
            crossed = float(candle["low"]) < level
            break_type = "BELOW"

        else:
            crossed = float(candle["high"]) > level
            break_type = "ABOVE"

        if crossed:
            return {
                "detected": True,
                "direction": side,
                "bos_index": bos_index,
                "inducement_index": index,
                "inducement_level": level,
                "break_type": break_type,
                "break_price": (
                    float(candle["low"])
                    if side == "BULLISH"
                    else float(candle["high"])
                ),
                "confirmation": (
                    "First qualifying pullback-level break "
                    "after BOS detected."
                ),
            }

    return {
        "detected": False,
        "direction": side,
        "bos_index": bos_index,
        "inducement_index": None,
        "inducement_level": level,
        "break_type": None,
        "break_price": None,
        "confirmation": (
            "No qualifying inducement break found after BOS."
        ),
    }
